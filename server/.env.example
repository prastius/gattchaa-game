# Gattchaa Town API (see docs/gattchaa-town-api.md). Leave GATTCHAA_API_URL empty
# to run the town without live shop data (no requests are made to the shop).
# Without it, signing in and player shops are off too.
GATTCHAA_API_URL=https://gattchaaoripa.com/api/town/v1
GATTCHAA_API_KEY=
# Same secret as TOWN_WEBHOOK_SECRET on the Laravel side.
GATTCHAA_WEBHOOK_SECRET=
# Base for menu links (daily login, marketplace…)
GATTCHAA_SITE_URL=https://gattchaaoripa.com
# "Sign in with Gattchaa" sends players here (defaults to GATTCHAA_SITE_URL + /town/enter).
# GATTCHAA_SIGNIN_URL=https://gattchaaoripa.com/town/enter

# Saved accounts and open shops (SQLite). Defaults to server/data/town.db.
# DB_PATH=/var/lib/gattchaa-town/town.db
