{
  "name": "@my-world/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outfile=build/index.js",
    "start": "node --enable-source-maps build/index.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.40",
    "colyseus": "^0.18.9",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
